{
  "name": "proof-jev",
  "version": "0.8.0",
  "private": true,
  "description": "Code review, diff analysis, and mutation testing for coding agents. Find bugs that passing tests miss.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamza-paracha/proof-jev.git"
  },
  "homepage": "https://github.com/hamza-paracha/proof-jev#readme",
  "bugs": "https://github.com/hamza-paracha/proof-jev/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "verify": "node bin/vouch.mjs",
    "verify:mcp": "node bin/vouch.mjs --stdio",
    "plugin:build": "node scripts/build-plugin.mjs",
    "verify:install": "tsx scripts/verify-install.ts",
    "verify:change-demo": "tsx scripts/verify-change-demo.ts",
    "verify:review-live": "tsx --env-file-if-exists=.env scripts/verify-review-live.ts",
    "review:build": "node scripts/build-review-package.mjs",
    "verify:review-install": "tsx scripts/verify-review-install.ts",
    "review:eval": "tsx scripts/evaluate-review.ts",
    "verify:plugin": "tsx scripts/verify-plugin.ts",
    "verify:repository": "tsx scripts/verify-repository.ts",
    "verify:external": "tsx scripts/verify-external.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "tsx": "^4.23.13",
    "typescript-ast": "npm:typescript@5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2"
  },
  "bin": {
    "proof-jev": "bin/vouch.mjs",
    "proof-jev-guard": "bin/guard.mjs",
    "vouch": "bin/vouch.mjs",
    "vouch-guard": "bin/guard.mjs",
    "vouch-jev": "bin/vouch.mjs",
    "vouch-jev-guard": "bin/guard.mjs"
  },
  "files": [
    "bin/",
    "docs/plugin.md",
    "docs/code-verification.md",
    "docs/structured-review.md",
    "docs/review-evaluation.md",
    "docs/review-quality-baseline.json",
    "docs/roadmap.md",
    "docs/validation.md",
    "scripts/verify-change-demo.ts",
    "test/helpers/change-fixture.ts",
    "scripts/evaluate-review.ts",
    "evals/review/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "scripts/verify-review-live.ts",
    "src/",
    "docs/review-validation.json",
    "docs/repository-validation.json",
    "docs/automatic-validation.json",
    "docs/task-loop.md",
    "docs/external-validation.json",
    "evals/external/",
    "scripts/verify-external.ts",
    "scripts/verify-codex-hooks.py"
  ],
  "keywords": [
    "mcp",
    "coding-agents",
    "verification",
    "codex",
    "claude-code",
    "mutation-testing",
    "change-impact-analysis",
    "code-review",
    "jev"
  ]
}
